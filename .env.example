# Copiá este archivo como .env.local y completá los valores.
# .env.local está ignorado por git y nunca se sube al repositorio.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API

# URL del proyecto. Ej: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" / "publishable").
# Viaja al navegador y es visible para cualquiera: eso es esperado y correcto.
# Lo que protege los datos son las políticas RLS de la base, no esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio ("service_role" / "secret"). SALTEA TODAS LAS POLÍTICAS RLS.
# Solo para scripts ejecutados desde tu máquina.
# Nunca la uses en código que llegue al navegador, ni la subas a ningún lado.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión a la base, para aplicar migraciones con `npm run db:push`.
# Panel de Supabase → Connect → Direct (Connection string) → Session pooler.
# Se elige el "Session pooler" y no la conexión directa porque esta última
# suele ser solo IPv6 en proyectos nuevos, y muchas conexiones hogareñas no lo
# tienen. Incluye la contraseña de la base: nunca la compartas.
SUPABASE_DB_URL=

# ─── Aplicación ────────────────────────────────────────────────────────────
# URL pública del sitio. En local dejala como está.
# En Vercel, poné la URL real del deploy (se usa para los links compartidos
# y para el callback de OAuth de Discord).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
